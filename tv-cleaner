     case "${ans,,}" in q) return 2;; *) continue;; esac
   fi
   read -rp "[A] Apply this season  [S] Skip  [Q] Quit guided cleanup: " ans
   case "${ans,,}" in q) return 2;; a)
     mkdir -p "$DESTINATION/$showname/Season $(printf '%02d' "$sn")"
     e=1
     for file in "${eps[@]}"; do
       target="$DESTINATION/$showname/Season $(printf '%02d' "$sn")/$showname S$(printf '%02d' "$sn")E$(printf '%02d' "$e").${file##*.}"
       if [ -e "$target" ]; then echo "COLLISION - skipped: $target"; log "COLLISION $target"; else mv -n -- "$file" "$target" && log "MOVE $file -> $target"; fi
       ((e+=1))
     done
     for file in "${playalls[@]}"; do
       target="$QUARANTINE/$showname/Season $(printf '%02d' "$sn")/PLAY-ALL - $(basename "$file")"; mkdir -p "$(dirname "$target")"; mv -n -- "$file" "$target" && log "QUARANTINE $file -> $target"
     done
     # Purge generated Jellyfin trickplay data from the processed source tree.
     find "$show" -depth -type f -iname '*.trickplay' -delete 2>/dev/null || true
     find "$show" -depth -type d -iname '*.trickplay' -exec rm -rf -- {} + 2>/dev/null || true

     # Then remove every directory that is now completely empty, bottom-up.
     # Repeat so Disc -> Season -> Show can all disappear in the same cleanup.
     while find "$show" -depth -mindepth 0 -type d -empty -print -exec rmdir -- {} \; 2>/dev/null | grep -q .; do :; done

     echo "Applied Season $(printf '%02d' "$sn")."
     echo ".trickplay data and empty source folders removed."
     refresh_jellyfin || true;;
   esac
 done
}

guided(){
 ensure_ffprobe || { echo "Cannot continue without ffprobe."; pause; return; }
 local s
 for s in "$SOURCE"/*/; do
   [ -d "$s" ] || continue
   # Ignore leftover show folders that contain no actual video files.
   if ! find "$s" -type f -regextype posix-extended -iregex "$VIDEO_RE" -print -quit 2>/dev/null | grep -q .; then
     continue
   fi
   guided_show "${s%/}" || break
 done
 pause
}

clean_source(){
 [ -d "$SOURCE" ] || { echo "Source not found: $SOURCE"; pause; return; }
 local empty_count trick_count
 empty_count=$(find "$SOURCE" -type d -empty 2>/dev/null | wc -l)
 trick_count=$(find "$SOURCE" -depth \( -type d -o -type f \) -iname '*.trickplay' 2>/dev/null | wc -l)
 echo
 echo "Source cleanup"
 echo "  Empty folders:     $empty_count"
 echo "  .trickplay items:  $trick_count"
 ((empty_count==0 && trick_count==0)) && { echo "Nothing to clean."; pause; return; }
 echo
 echo "This removes .trickplay data and completely empty source folders."
 echo "No video files are removed."
 read -rp "Clean the TV source now? [y/N] " a
 [[ "${a,,}" = y ]] || { echo "Cancelled."; pause; return; }

 find "$SOURCE" -depth -type f -iname '*.trickplay' -print -delete 2>/dev/null | while IFS= read -r p; do log "DELETE_TRICKPLAY $p"; done
 find "$SOURCE" -depth -type d -iname '*.trickplay' -print -exec rm -rf -- {} + 2>/dev/null | while IFS= read -r p; do log "DELETE_TRICKPLAY $p"; done

 # Repeated bottom-up passes remove empty parents exposed by the cleanup.
 while find "$SOURCE" -depth -mindepth 1 -type d -empty -print -exec rmdir -- {} \; 2>/dev/null | grep -q .; do :; done

 echo "Source cleanup complete."
 log "SOURCE_CLEANUP empty_before=$empty_count trickplay_before=$trick_count"
 pause
}

refresh_jellyfin(){
 [ -n "${JELLYFIN_URL:-}" ] || return 0
 [ -n "${JELLYFIN_API_KEY:-}" ] || return 0
 command -v curl >/dev/null 2>&1 || { echo "Jellyfin refresh skipped: curl is not installed."; log "JELLYFIN_REFRESH skipped_no_curl"; return 1; }
 local url="${JELLYFIN_URL%/}/Library/Refresh" code
 code=$(curl -sS -o /dev/null -w '%{http_code}' -X POST "$url" -H "X-Emby-Token: $JELLYFIN_API_KEY" --connect-timeout 5 --max-time 15) || {
   echo "Jellyfin refresh failed: could not reach $JELLYFIN_URL"
   log "JELLYFIN_REFRESH failed_connect $JELLYFIN_URL"
   return 1
 }
 if [[ "$code" =~ ^2 ]]; then
   echo "Jellyfin library scan triggered."
   log "JELLYFIN_REFRESH success code=$code"
   return 0
 fi
 echo "Jellyfin refresh failed (HTTP $code)."
 log "JELLYFIN_REFRESH failed code=$code"
 return 1
}

settings(){
 echo "Config: $CONFIG"; echo "SOURCE=$SOURCE"; echo "DESTINATION=$DESTINATION"; echo "QUARANTINE=$QUARANTINE"; echo "PLAYALL_TOLERANCE_SECONDS=$PLAYALL_TOLERANCE_SECONDS"; echo "JELLYFIN_URL=${JELLYFIN_URL:-<not configured>}"; if [ -n "${JELLYFIN_API_KEY:-}" ]; then echo "JELLYFIN_API_KEY=<configured>"; else echo "JELLYFIN_API_KEY=<not configured>"; fi; echo; echo "Edit with: nano \"$CONFIG\""; pause
}
menu(){
 while true; do
 clear
 cat <<EOF
╔══════════════════════════════════════════════════╗
║                 TV CLEANER                       ║
║               Jellyfin Mode v$VERSION              ║
╚══════════════════════════════════════════════════╝
Source:      $SOURCE
Destination: $DESTINATION

[1] Guided cleanup
[2] Scan source (read-only)
[3] Settings
[4] View operation log
[5] View latest scan report
[6] Clean source (.trickplay + empty folders)
[Q] Quit
EOF
 read -rp "Select: " c
 case "${c,,}" in 1) guided;;2) scan_all;;3) settings;;4) less "$LOG" 2>/dev/null || pause;;5) less "$LATEST_REPORT" 2>/dev/null || { echo "No scan report yet."; pause; };;6) clean_source;;q) exit 0;;esac
 done
}
menu
